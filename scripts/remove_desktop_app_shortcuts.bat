@echo off
chcp 65001 >nul
setlocal
REM Double-click: previews app-type desktop shortcuts, then asks Y/N.
REM Deletion moves shortcuts to the Recycle Bin (recoverable), not permanent.
REM Options (run from a command prompt): -Public  -IncludeUrl
powershell -NoProfile -ExecutionPolicy Bypass -Command "$Public=$args -contains '-Public'; $IncludeUrl=$args -contains '-IncludeUrl'; $appExts=@('.exe','.bat','.cmd','.com','.msi','.msp','.scr'); $ws=New-Object -ComObject WScript.Shell; $desktops=@([Environment]::GetFolderPath('Desktop')); if($Public){$desktops+=[Environment]::GetFolderPath('CommonDesktopDirectory')}; $toDel=@(); foreach($d in $desktops){ if(-not(Test-Path -LiteralPath $d)){continue}; Get-ChildItem -LiteralPath $d -File -Force -ErrorAction SilentlyContinue | ForEach-Object{ $ext=$_.Extension.ToLower(); if($ext-ne '.lnk' -and -not ($IncludeUrl -and $ext-eq '.url')){return}; if($ext-eq '.url'){$t='(web shortcut)'; $cls='Internet'; return}; $t=$ws.CreateShortcut($_.FullName).TargetPath; if([string]::IsNullOrWhiteSpace($t)){$cls='Unknown'; return}; if(Test-Path -LiteralPath $t -PathType Container){$cls='Folder'; return}; if($appExts -contains [IO.Path]::GetExtension($t).ToLower()){$cls='Application'} else {$cls='OtherFile'}; Write-Host ('[{0}] {1}' -f $cls,$_.FullName); if($cls-eq 'Application'){$toDel+=@{Shortcut=$_.FullName;Target=$t}} }; }; Write-Host ''; Write-Host '==== Summary ===='; Write-Host ('Application-type shortcuts: {0}' -f $toDel.Count); if($toDel.Count-eq 0){Write-Host 'Nothing to remove.'; exit 0}; $ans=Read-Host ('Send the above {0} application shortcuts to the Recycle Bin? [Y/N]' -f $toDel.Count); if($ans -notmatch '^[Yy]'){Write-Host 'Cancelled.'; exit 0}; Add-Type -AssemblyName Microsoft.VisualBasic; $ok=0; foreach($r in $toDel){ try{[Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile($r.Shortcut,'OnlyErrorDialogs','SendToRecycleBin'); Write-Host ('   recycled: {0}' -f $r.Shortcut); $ok++} catch{Write-Warning ('   failed: {0} - {1}' -f $r.Shortcut,$_.Exception.Message)} }; Write-Host ('Done: recycled {0}/{1}.' -f $ok,$toDel.Count)"
pause
